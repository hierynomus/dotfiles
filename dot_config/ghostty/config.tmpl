# Ghostty reads this from ~/.config/ghostty/config on both macOS and
# Linux (it deliberately uses the XDG path everywhere, unlike most macOS
# apps) — that's what makes it a good pick for a config you want to look
# identical on both machines. Run `ghostty +list-themes` to see exact
# theme names available on this build if the one below doesn't match.

theme = "Solarized Dark"
font-family = "SUSEMono Nerd Font"
font-size = {{ if eq .chezmoi.os "darwin" }}13{{ else }}11{{ end }}
cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true

window-padding-x = 4
window-padding-y = 2
window-decoration = true

confirm-close-surface = false

# Shell integration (prompt marks, cwd/title tracking, etc.) — Ghostty
# auto-detects zsh, this is just explicit.
shell-integration = zsh
shell-integration-features = cursor,sudo,title

keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
