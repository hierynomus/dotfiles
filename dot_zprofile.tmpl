#
# Runs once at login, before .zshrc. PATH and environment setup that
# doesn't need to happen on every single subshell goes here.
#

{{ if eq .chezmoi.os "darwin" -}}
if [[ -z "$BROWSER" ]]; then
  export BROWSER='open'
fi
{{ end -}}

if [[ -z "$PAGER" ]]; then
  export PAGER='less'
fi

# Ensure path arrays do not contain duplicates.
typeset -gU cdpath fpath mailpath path

{{ if eq .chezmoi.os "darwin" -}}
# macOS preloads PATH via path_helper (from /etc/paths + /etc/paths.d/*);
# clear it and re-run first so it establishes the system baseline *before*
# our own entries below get prepended onto it. This has to come before the
# `path=(...)` block, not after — path_helper doesn't know about anything
# we've added, so running it later would silently wipe $HOME/.local/bin
# (and everything else below) right back out.
if [ -x /usr/libexec/path_helper ]; then
    PATH=''
    eval "$(/usr/libexec/path_helper -s)"
fi

if [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /usr/local/bin/brew ]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi
{{ end -}}

# Directories zsh searches for programs, in priority order.
path=(
  $HOME/bin(N)
  $HOME/.local/bin(N)
{{ if eq .chezmoi.os "darwin" -}}
  /opt/homebrew/{,s}bin(N)
  /usr/local/{,s}bin(N)
{{ end -}}
  $path
)

# Mouse-wheel scrolling disabled by -X (disable screen clearing); drop -X to enable it.
if [[ -z "$LESS" ]]; then
  export LESS='-g -i -M -R -S -w -X -z-4'
fi

if [[ -z "$LESSOPEN" ]] && (( $#commands[(i)lesspipe(|.sh)] )); then
  export LESSOPEN="| /usr/bin/env $commands[(i)lesspipe(|.sh)] %s 2>&-"
fi

if which go > /dev/null 2>&1; then
  PATH="$PATH:$(go env GOPATH)/bin"
fi

# mise shims, so version-managed tools resolve in non-interactive shells too
# (the interactive `mise activate` hook lives in .zshrc).
if [[ -d "${XDG_DATA_HOME:-$HOME/.local/share}/mise/shims" ]]; then
  path=("${XDG_DATA_HOME:-$HOME/.local/share}/mise/shims" $path)
fi

export PATH
