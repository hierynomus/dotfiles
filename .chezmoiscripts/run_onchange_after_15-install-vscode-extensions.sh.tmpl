#!/usr/bin/env bash
# Installs the VS Code extensions the settings in this repo assume are
# present (currently just the Catppuccin theme used by
# workbench.colorTheme). Re-runs whenever this list changes.
#
# On a headless (gui=false) machine, everything below the `exit 0` a few
# lines down is genuinely unreachable — that's the point, not a bug — but
# CI's shellcheck job renders every gui/privileged combination, and from
# a single rendered copy's point of view it's correct to flag the rest
# of the file as unreachable code in that variant.
# shellcheck disable=SC2317
set -euo pipefail

{{ if not .gui -}}
exit 0
{{ end -}}

extensions=(catppuccin.catppuccin-vsc)

CODE="$(command -v code || true)"
if [ -z "$CODE" ]; then
  echo "NOTE: 'code' CLI not found on PATH — skipping VS Code extension install."
  echo "      Install VS Code, then re-run 'chezmoi apply' to pick this up."
  exit 0
fi

installed="$("$CODE" --list-extensions)"
for ext in "${extensions[@]}"; do
  if ! grep -qi "^${ext}$" <<< "$installed"; then
    echo "==> Installing VS Code extension: $ext"
    "$CODE" --install-extension "$ext"
  fi
done
