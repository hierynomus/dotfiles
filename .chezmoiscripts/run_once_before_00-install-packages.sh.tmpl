#!/usr/bin/env bash
# Runs once (chezmoi hashes this script's content — edit it and it'll run
# again exactly once) before any dotfiles are applied. Installs the tools
# the rest of this repo assumes exist. Safe to re-run by hand too:
# `chezmoi state delete-bucket --bucket=scriptState && chezmoi apply` forces
# every run_once_ script to fire again.
set -euo pipefail

echo "==> Bootstrapping packages for {{ .chezmoi.os }}/{{ .chezmoi.arch }}"

{{ if eq .chezmoi.os "darwin" -}}
if ! command -v brew > /dev/null 2>&1; then
  echo "==> Installing Homebrew"
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi
eval "$(/opt/homebrew/bin/brew shellenv 2>/dev/null || /usr/local/bin/brew shellenv)"

# Languages and most CLI tools are handled by mise (see the global
# ~/.config/mise/config.toml and run_onchange_after_20-mise-install.sh);
# uv/node/python/scmpuff/etc. are pinned there, not installed here.
# pyenv/rbenv/nvm/SDKMAN are gone entirely.
brew_formulas=(zsh git tmux fzf tree go mise age)
# The Nerd Font for the prompt is installed from the repo's bundled TTFs
# by run_onchange_after_10-install-fonts.sh, not via a cask.
brew_casks=({{ if .gui }}ghostty{{ end }})

for f in "${brew_formulas[@]}"; do
  brew list "$f" > /dev/null 2>&1 || brew install "$f"
done
if (( ${#brew_casks[@]} )); then
  for c in "${brew_casks[@]}"; do
    brew list --cask "$c" > /dev/null 2>&1 || brew install --cask "$c"
  done
fi

{{ else if eq .chezmoi.os "linux" -}}
{{ if .privileged -}}
# Nearly all of these machines run openSUSE, so zypper is the primary path;
# apt/dnf branches are kept for the occasional Debian/Fedora box. No
# Linuxbrew — mise covers the tools that aren't packaged natively.
if command -v zypper > /dev/null 2>&1; then
  sudo zypper --non-interactive install zsh git tmux fzf tree curl age
elif command -v apt-get > /dev/null 2>&1; then
  sudo apt-get update -y
  sudo apt-get install -y zsh git tmux fzf tree curl fonts-firacode age
elif command -v dnf > /dev/null 2>&1; then
  sudo dnf install -y zsh git tmux fzf tree curl age
fi
{{ else -}}
echo "NOTE: 'privileged' is false — skipping the sudo package install."
echo "      Make sure zsh, git, tmux, fzf, tree, curl and age are present."
{{ end -}}

# mise — version manager for languages and CLI tools (replaces pyenv,
# rbenv, nvm, SDKMAN). Installs to ~/.local/bin, which is already on PATH.
# The tools it manages are pinned in ~/.config/mise/config.toml and
# installed by run_onchange_after_20-mise-install.sh once that's applied.
if ! command -v mise > /dev/null 2>&1 && [ ! -x "$HOME/.local/bin/mise" ]; then
  echo "==> Installing mise"
  curl -fsSL https://mise.run | sh
fi

# Nerd Font for the powerlevel10k prompt icons is installed by
# run_onchange_after_10-install-fonts.sh from the fonts checked into the
# repo — nothing to download here.

{{ if .gui -}}
if ! command -v ghostty > /dev/null 2>&1; then
  echo "NOTE: Ghostty isn't packaged consistently across Linux distros yet."
  echo "      Install it from https://ghostty.org/download for your distro,"
  echo "      then re-run 'chezmoi apply' to pick up ~/.config/ghostty/config."
fi
{{ end -}}
{{ end -}}

# antidote (~/.antidote) and TPM (~/.tmux/plugins/tpm) are cloned and kept
# up to date by chezmoi via .chezmoiexternal.toml — nothing to do here.

echo "==> Done. Open a new shell, then inside tmux press prefix+I to fetch plugins."
echo "==> Run 'p10k configure' the first time you want to tweak the prompt."
