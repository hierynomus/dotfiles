# Prompt backend: "p10k" (default) or "starship". Toggle with the
# `prompt-backend` function (dot_config/zsh/functions.zsh) — it writes this
# state file and execs a new shell. Nothing here is chezmoi-managed; it's a
# plain per-machine preference file, absent until you switch at least once.
PROMPT_BACKEND=p10k
if [[ -r "${ZDOTDIR:-$HOME}/.config/zsh/prompt-backend" ]]; then
  PROMPT_BACKEND=$(<"${ZDOTDIR:-$HOME}/.config/zsh/prompt-backend")
fi

if [[ $PROMPT_BACKEND == p10k ]]; then
  # Enable Powerlevel10k instant prompt. Should stay close to the top of
  # ~/.zshrc. Anything that reads input (password prompts, [y/n]) must go
  # above this block; everything else goes below.
  if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
    source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
  fi
fi

#
# antidote — plugin manager. Loads the static bundle if it's up to date,
# rebuilds it if the plugin list changed since the last shell start.
# ~/.antidote itself is cloned/updated by chezmoi (.chezmoiexternal.toml);
# the clone below is only a fallback for a shell started before the first
# `chezmoi apply` has run. The starship backend uses a separate plugin list
# (no powerlevel10k) with its own cached bundle, so switching backends never
# needs a rebuild of the other one's cache.
#
ANTIDOTE_HOME="${ZDOTDIR:-$HOME}/.antidote"
if [[ ! -d "$ANTIDOTE_HOME" ]]; then
  git clone --depth=1 https://github.com/mattmc3/antidote.git "$ANTIDOTE_HOME"
fi
source "$ANTIDOTE_HOME/antidote.zsh"

zsh_plugins_txt="${ZDOTDIR:-$HOME}/.zsh_plugins.txt"
[[ $PROMPT_BACKEND == starship ]] && zsh_plugins_txt="${ZDOTDIR:-$HOME}/.zsh_plugins-starship.txt"
zsh_plugins="${zsh_plugins_txt%.txt}.zsh"
if [[ ! "$zsh_plugins" -nt "$zsh_plugins_txt" ]]; then
  antidote bundle < "$zsh_plugins_txt" > "$zsh_plugins"
fi
source "$zsh_plugins"

if [[ $PROMPT_BACKEND == p10k ]]; then
  # To customize the prompt, run `p10k configure` or edit ~/.p10k.zsh.
  [[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
elif (( $+commands[starship] )); then
  # Config: dot_config/starship.toml -> ~/.config/starship.toml.
  eval "$(starship init zsh)"
else
  echo "prompt-backend: starship selected but not installed (mise install starship)" >&2
fi

#
# Shell config split out for readability — see dot_config/zsh/ in the
# chezmoi source, deployed to ~/.config/zsh/.
#
for f in "${ZDOTDIR:-$HOME}"/.config/zsh/*.zsh; do
  source "$f"
done

#
# History
#
setopt append_history
setopt extended_history
setopt hist_expire_dups_first
setopt hist_ignore_all_dups
setopt hist_ignore_dups
setopt hist_ignore_space
setopt hist_verify
setopt inc_append_history
setopt share_history

export HISTSIZE=100000
export SAVEHIST=100000
export HISTFILE="${HOME}/.zsh_history"
export HISTIGNORE="ls:cd:cd -:pwd:exit:date:* --help"

ulimit -S -n 10000 2>/dev/null

#
# Dev tool integrations — every one of these is conditional on the tool
# actually being installed, so this file behaves the same whether or not
# a given machine has it.
#

if which kubectl > /dev/null 2>&1; then
  source <(kubectl completion zsh)
fi

if which scmpuff > /dev/null 2>&1; then
  eval "$(scmpuff init -s)"
fi

# fzf shell integration: Ctrl-R history search, Ctrl-T file picker, Alt-C
# cd. `fzf --zsh` is fzf >= 0.48; older builds just print nothing here.
if which fzf > /dev/null 2>&1; then
  source <(fzf --zsh 2>/dev/null)
fi

# mise — version manager for languages (python, node, ruby, java, …) and
# CLI tools. Replaces pyenv/rbenv/nvm/SDKMAN; per-project Python envs are
# handled by uv. Non-interactive shells get the shims via .zprofile.
if which mise > /dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

# zoxide — `z <partial>` jumps to a frecent directory, `zi` picks with fzf.
if which zoxide > /dev/null 2>&1; then
  eval "$(zoxide init zsh)"
fi

# Google Cloud SDK
if [ -f "$HOME/google-cloud-sdk/path.zsh.inc" ]; then . "$HOME/google-cloud-sdk/path.zsh.inc"; fi
if [ -f "$HOME/google-cloud-sdk/completion.zsh.inc" ]; then . "$HOME/google-cloud-sdk/completion.zsh.inc"; fi

{{ if eq .chezmoi.os "darwin" -}}
# Rancher Desktop
### MANAGED BY RANCHER DESKTOP START (DO NOT EDIT)
export PATH="$HOME/.rd/bin:$PATH"
### MANAGED BY RANCHER DESKTOP END (DO NOT EDIT)

# pnpm
export PNPM_HOME="$HOME/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac
{{ else -}}
# pnpm
export PNPM_HOME="$HOME/.local/share/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac
{{ end -}}
